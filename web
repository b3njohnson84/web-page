<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>6-Column Editable Form</title>

<style>
  body {
    font-family: Arial, sans-serif;
    padding: 16px;
    background: #f4f4f4;
  }

  h1 {
    margin-bottom: 10px;
  }

  form {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 8px;
    margin-bottom: 12px;
  }

  input {
    padding: 8px;
    font-size: 14px;
  }

  button {
    padding: 10px;
    cursor: pointer;
    border: none;
    border-radius: 4px;
  }

  .save-btn {
    grid-column: span 6;
    background: #007bff;
    color: white;
  }

  .save-btn:hover {
    background: #0056b3;
  }

  .actions {
    margin-bottom: 12px;
  }

  .export-btn {
    background: #28a745;
    color: white;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    background: white;
  }

  th, td {
    border: 1px solid #ccc;
    padding: 6px;
    font-size: 14px;
    text-align: left;
  }

  th {
    background: #eee;
  }

  .edit-btn {
    background: #ffc107;
  }

  .delete-btn {
    background: #dc3545;
    color: white;
  }

  .save-row-btn {
    background: #28a745;
    color: white;
  }

